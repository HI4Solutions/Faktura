{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.md", "**/.*"],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      { "source": "/personvern", "destination": "/personvern.html", "type": 301 },
      { "source": "/vilkar", "destination": "/vilkar.html", "type": 301 },
      { "source": "/databehandleravtale", "destination": "/databehandleravtale.html", "type": 301 },
      { "source": "/underleverandorer", "destination": "/underleverandorer.html", "type": 301 },
      { "source": "/informasjonskapsler", "destination": "/informasjonskapsler.html", "type": 301 },
      { "source": "/favicon.ico", "destination": "/favicon.svg", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "faktura-api",
          "region": "europe-north1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/fonter/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(css|png|svg)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "**/*.@(html|xml|txt|js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}

{
  "name": "faktura-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev:api": "ROLLE=api tsx watch src/main.ts",
    "dev:worker": "ROLLE=worker PORT=8081 tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@google-cloud/kms": "^6.2.1",
    "@google-cloud/pubsub": "^6.1.0",
    "@google-cloud/storage": "^8.2.0",
    "@google-cloud/tasks": "^7.2.1",
    "@hono/node-server": "^2.1.3",
    "@simplewebauthn/server": "^14.0.3",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "resend": "^6.32.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "saxon-js": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "xslt3": "^2.7.0"
  }
}
